from typing import AnyStr, List, Literal, Type, Union, overload

def write(value: unicode) -> None: ...
def either(value: Union[unicode, str]) -> None: ...
def consume_list(values: List[unicode]) -> None: ...
@overload
def classify(value: unicode) -> unicode: ...
@overload
def classify(value: str) -> str: ...
@overload
def select(value: int) -> int: ...
@overload
def select(value: unicode) -> unicode: ...

def same(first: AnyStr, second: AnyStr) -> AnyStr: ...
def require_literal(value: Literal[u"wide"]) -> None: ...
def require_class(value: Type[unicode]) -> None: ...
@overload
def measure(value: unicode) -> unicode: ...
@overload
def measure(value: bytearray) -> int: ...

def double(first: unicode, second: unicode) -> None: ...
